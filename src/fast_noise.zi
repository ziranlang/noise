// FastNoiseLite gradient noise in pure Ziran: OpenSimplex2, OpenSimplex2S,
// Perlin, ValueCubic and Value, with FBm, Ridged and PingPong fractals.
// Ported from FastNoiseLite 1.1 (MIT, Copyright (c) 2023 Jordan Peck and
// contributors, see LICENSE). Every call reads the state only, so one state
// can be shared between threads. Results follow the C float32 implementation.

NoiseType :: enum { OpenSimplex2; OpenSimplex2S; Perlin; ValueCubic; Value; }
FractalType :: enum { None; FBm; Ridged; PingPong; }
RotationType3D :: enum { None; ImproveXYPlanes; ImproveXZPlanes; }

NoiseState :: struct {
    seed: s32;
    frequency: float32;
    noise_type: NoiseType;
    rotation_type_3d: RotationType3D;
    fractal_type: FractalType;
    octaves: s32;
    lacunarity: float32;
    gain: float32;
    weighted_strength: float32;
    ping_pong_strength: float32;
}

// FastNoiseLite's defaults: seed 1337, frequency 0.01, OpenSimplex2, no
// fractal, 3 octaves, lacunarity 2, gain 0.5, ping-pong strength 2.
NoiseCreate :: () -> NoiseState {
    state: NoiseState
    state.seed = 1337
    state.frequency = 0.01
    state.noise_type = NoiseType.OpenSimplex2
    state.rotation_type_3d = RotationType3D.None
    state.fractal_type = FractalType.None
    state.octaves = 3
    state.lacunarity = 2.0
    state.gain = 0.5
    state.weighted_strength = 0.0
    state.ping_pong_strength = 2.0
    return state
}

